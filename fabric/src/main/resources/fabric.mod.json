{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "Louis Grunenwald (Delta2Force) - original VM Computers"
  ],
  "contact": {
    "homepage": "https://github.com/MosheBarami/vm-computers-hypervisor-x",
    "sources": "https://github.com/MosheBarami/vm-computers-hypervisor-x",
    "issues": "https://github.com/MosheBarami/vm-computers-hypervisor-x/issues"
  },
  "license": "${license}",
  "icon": "hypervisorx_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.hypervisorx.fabric.HyperVisorXFabric"
    ],
    "client": [
      "net.hypervisorx.fabric.client.HyperVisorXFabricClient"
    ],
    "modmenu": [
      "net.hypervisorx.fabric.client.HvxModMenu"
    ]
